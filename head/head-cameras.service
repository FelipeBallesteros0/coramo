[Unit]
Description=Camaras de la cabeza CORAMO (camera_ros)
After=network-online.target
Wants=network-online.target

[Service]
User=coramo
# LD_LIBRARY_PATH: camera_ros trae su propia libcamera 0.7.2, que no reconoce el
# hardware de la Raspberry ("Unable to acquire a CFE instance"). La del sistema
# (0.7.0 de Ubuntu, con los parches de Raspberry) comparte soname, asi que basta
# con anteponerla.
ExecStart=/bin/bash -lc "source /opt/ros/lyrical/setup.bash && \
  export RMW_IMPLEMENTATION=rmw_fastrtps_cpp ROS_DISCOVERY_SERVER=192.168.1.103:11811 ROS_DOMAIN_ID=7 && \
  export LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH && \
  exec ros2 launch /home/coramo/coramo/head/head_cameras.launch.py"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
